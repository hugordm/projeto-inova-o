# Copie este arquivo para .env.local e preencha. NUNCA suba o .env.local para o Git.
# Estas variáveis são lidas só no servidor. Não use o prefixo NEXT_PUBLIC_.

# Chave da API da Anthropic (Console > API Keys). Começa com "sk-ant-".
ANTHROPIC_API_KEY=

# Nome exato do modelo, copiado da documentação de modelos da Anthropic:
# https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL=
